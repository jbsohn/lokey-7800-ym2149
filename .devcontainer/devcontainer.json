{
  "name": "Atari 7800 YM2149 Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "options": [
      "--platform=linux/amd64"
    ]
  },
  "runArgs": [
    "--platform=linux/amd64"
  ],
  "postCreateCommand": "cd pcb && bun install",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-vscode.live-server"
      ]
    }
  },
  "remoteUser": "root"
}
